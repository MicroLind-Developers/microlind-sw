; Register ABI for RAM modules. Entries are JMP instructions, not C wrappers.
    ifndef MODULE_INC
MODULE_INC equ 1
BIOS_MODULE_API_BASE      equ $F880
BIOS_MODULE_API_VERSION   equ 1
BIOS_MODULE_API_COUNT     equ 20
BIOS_MODULE_API_ENTRIES   equ BIOS_MODULE_API_BASE+8
BIOS_MODULE_CF_INIT       equ BIOS_MODULE_API_ENTRIES+0*3
BIOS_MODULE_CF_READ       equ BIOS_MODULE_API_ENTRIES+1*3
BIOS_MODULE_CF_WRITE      equ BIOS_MODULE_API_ENTRIES+2*3
BIOS_MODULE_SERIAL_PRINT  equ BIOS_MODULE_API_ENTRIES+3*3
BIOS_MODULE_SERIAL_PUTC   equ BIOS_MODULE_API_ENTRIES+4*3
BIOS_MODULE_SERIAL_GETC   equ BIOS_MODULE_API_ENTRIES+5*3
BIOS_MODULE_JOY1          equ BIOS_MODULE_API_ENTRIES+6*3
BIOS_MODULE_VDC_CURSOR    equ BIOS_MODULE_API_ENTRIES+7*3
BIOS_MODULE_VDC_BYTE      equ BIOS_MODULE_API_ENTRIES+8*3
BIOS_MODULE_VDC_ADDRESS   equ BIOS_MODULE_API_ENTRIES+9*3
BIOS_MODULE_VDC_SELECTED  equ BIOS_MODULE_API_ENTRIES+10*3
BIOS_MODULE_VDC_WRITE     equ BIOS_MODULE_API_ENTRIES+11*3
BIOS_MODULE_VDC_READ      equ BIOS_MODULE_API_ENTRIES+12*3
BIOS_MODULE_VDC_CLEAR     equ BIOS_MODULE_API_ENTRIES+13*3
BIOS_MODULE_VDC_PRINT     equ BIOS_MODULE_API_ENTRIES+14*3
BIOS_MODULE_VDC_FG        equ BIOS_MODULE_API_ENTRIES+15*3
BIOS_MODULE_VDC_BG        equ BIOS_MODULE_API_ENTRIES+16*3
BIOS_MODULE_IRQ_INSTALL   equ BIOS_MODULE_API_ENTRIES+17*3
BIOS_MODULE_LOAD          equ BIOS_MODULE_API_ENTRIES+18*3
BIOS_MODULE_RUN           equ BIOS_MODULE_API_ENTRIES+19*3

MLP_ERR_IO                equ 1
MLP_ERR_METADATA          equ 2
MLP_ERR_NOT_FOUND         equ 3
MLP_ERR_LAYOUT            equ 4
MLP_ERR_HEADER            equ 5
MLP_ERR_CHECKSUM          equ 6

; MLP1 file header. Every word and long word is big-endian.
MLP_MAGIC                 equ $4D4C5031
MLP_ABI                   equ 4
MLP_KIND                  equ 6
MLP_LOAD                  equ 8
MLP_ENTRY                  equ 10
MLP_PAYLOAD_SIZE           equ 12
MLP_MEMORY_SIZE            equ 14
MLP_CHECKSUM               equ 16
MLP_HEADER_SIZE            equ 20
MLP_KIND_FILESYSTEM        equ 0
MLP_KIND_APPLICATION       equ 1
MLP_FILESYSTEM_BASE        equ $4000
MLP_FILESYSTEM_LIMIT       equ $C000
MLP_APPLICATION_BASE       equ $0400
MLP_APPLICATION_LIMIT      equ $4000
    endc
